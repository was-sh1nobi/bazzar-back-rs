# Postgres connection string (required)
DATABASE_URL=postgres://user:password@localhost:5432/bazzardb

# HS256 JWT secret — use a random string of >= 32 bytes (required)
# NEVER distribute this to game servers: it signs per-user login tokens.
JWT_SECRET=

# Optional
HOST=127.0.0.1
PORT=8080
RUST_LOG=info,actix_web=info
